{
  "name": "Vericore 0.8.0 Release Lab",
  "image": "mcr.microsoft.com/devcontainers/java:1-21-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "postCreateCommand": "chmod +x gradlew scripts/audit/*.sh 2>/dev/null || true",
  "customizations": {
    "vscode": {
      "extensions": ["vscjava.vscode-gradle", "vscjava.vscode-java-pack"]
    }
  },
  "remoteEnv": {"GRADLE_OPTS": "-Dorg.gradle.daemon=false"}
}
