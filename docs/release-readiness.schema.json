{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sonii-shivansh/Vericore/blob/main/docs/release-readiness.schema.json",
  "title": "Vericore Release Readiness Certificate",
  "type": "object",
  "required": [
    "schemaVersion",
    "project",
    "releaseVersion",
    "candidate",
    "checks",
    "overallReady",
    "generatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "project": { "const": "Vericore" },
    "releaseVersion": { "type": "string", "minLength": 1 },
    "candidate": {
      "type": "object",
      "required": ["sha", "ref"],
      "properties": {
        "sha": { "type": "string", "minLength": 40 },
        "ref": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["required", "result", "passed"],
        "properties": {
          "required": { "const": true },
          "result": { "type": "string" },
          "passed": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "overallReady": { "type": "boolean" },
    "generatedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
