{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vericore:schema:verification-receipt-v1.4",
  "title": "Vericore Verification Receipt",
  "type": "object",
  "required": [
    "schemaVersion",
    "repository",
    "preparedHead",
    "verifiedHead",
    "contractFingerprint",
    "status",
    "changedPaths",
    "plannedPaths",
    "unexpectedPaths",
    "deletedPaths",
    "verificationCommands",
    "verification",
    "safetyReasons",
    "verificationReasons",
    "analysisInputDigest",
    "candidateStateDigest",
    "postVerificationCandidateDigest",
    "candidateStateStable",
    "candidateStateFileCount",
    "postVerificationFileCount",
    "preparedBaselineDigest",
    "baselineManifestValid",
    "unplannedBaselineDriftPaths"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.4"
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "preparedHead": {
      "type": "string"
    },
    "verifiedHead": {
      "type": "string"
    },
    "contractFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "PASS",
        "REVIEW_REQUIRED",
        "FAIL"
      ]
    },
    "changedPaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "plannedPaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unexpectedPaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deletedPaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verificationCommands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "safetyReasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:vericore:schema:verification-execution-v1.0",
      "title": "Verification execution result",
      "type": "object",
      "required": [
        "commands",
        "commandsDeclared",
        "commandsExecuted",
        "allCommandsExecuted",
        "allCommandsPassed",
        "executionComplete"
      ],
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "urn:vericore:schema:verification-command-result-v1.0",
            "title": "Verification command result",
            "type": "object",
            "required": [
              "command",
              "executed",
              "exitCode",
              "timedOut",
              "durationMillis",
              "stdout",
              "stderr",
              "error"
            ],
            "properties": {
              "command": {
                "type": "string"
              },
              "executed": {
                "type": "boolean"
              },
              "exitCode": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "timedOut": {
                "type": "boolean"
              },
              "durationMillis": {
                "type": "integer",
                "minimum": 0
              },
              "stdout": {
                "type": "string"
              },
              "stderr": {
                "type": "string"
              },
              "error": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "commandsDeclared": {
          "type": "integer",
          "minimum": 0
        },
        "commandsExecuted": {
          "type": "integer",
          "minimum": 0
        },
        "allCommandsExecuted": {
          "type": "boolean",
          "description": "True when every declared command process was started; does not imply completion or success."
        },
        "allCommandsPassed": {
          "type": "boolean",
          "description": "True only when every declared command started, did not time out, and exited with code 0."
        },
        "executionComplete": {
          "type": "boolean",
          "description": "True when at least one command was declared and every command started, did not time out, and produced an exit code. A non-zero exit code is complete execution, but not a pass."
        }
      },
      "additionalProperties": false
    },
    "verificationReasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "analysisInputDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidateStateDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "postVerificationCandidateDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidateStateStable": {
      "type": "boolean"
    },
    "candidateStateFileCount": {
      "type": "integer",
      "minimum": 0
    },
    "postVerificationFileCount": {
      "type": "integer",
      "minimum": 0
    },
    "specificationEvaluation": {
      "type": [
        "object",
        "null"
      ],
      "title": "Structured change specification evaluation",
      "required": [
        "schemaVersion",
        "status",
        "criteria",
        "evaluatedCount",
        "notEvaluatedCount"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "INCONCLUSIVE",
            "NOT_EVALUATED"
          ]
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "statement",
              "status",
              "reason",
              "evidenceIds"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "REQUIRED_BEHAVIOR",
                  "FORBIDDEN_BEHAVIOR",
                  "PROTECTED_INVARIANT",
                  "ACCEPTANCE_CRITERION",
                  "REQUIRED_EVIDENCE",
                  "SPECIFICATION_VALIDITY"
                ]
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "INCONCLUSIVE",
                  "NOT_EVALUATED"
                ]
              },
              "reason": {
                "type": "string"
              },
              "evidenceIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "evaluatedCount": {
          "type": "integer",
          "minimum": 0
        },
        "notEvaluatedCount": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "junitTestReports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["schemaVersion", "parserVersion", "candidateSha", "candidateStateDigest", "executionId", "reportSha256", "status", "tests", "passed", "failed", "skipped", "cases"],
        "properties": {
          "schemaVersion": { "const": "1.0" },
          "parserVersion": { "type": "string", "minLength": 1 },
          "candidateSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
          "candidateStateDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "executionId": { "type": "string", "minLength": 1, "maxLength": 256 },
          "reportSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "status": { "enum": ["ALL_PASSED", "FAILED", "NO_TESTS", "SKIPPED_ONLY", "INCOMPLETE"] },
          "tests": { "type": "integer", "minimum": 0 },
          "passed": { "type": "integer", "minimum": 0 },
          "failed": { "type": "integer", "minimum": 0 },
          "skipped": { "type": "integer", "minimum": 0 },
          "cases": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["className", "name", "status"],
              "properties": {
                "className": { "type": ["string", "null"] },
                "name": { "type": "string", "minLength": 1 },
                "status": { "enum": ["PASSED", "FAILED", "SKIPPED"] }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "preparedBaselineDigest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "baselineManifestValid": {
      "type": "boolean"
    },
    "unplannedBaselineDriftPaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
