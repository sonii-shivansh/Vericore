{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vericore:schema:engineering-plan-v1.0",
  "title": "Vericore Engineering Plan",
  "type": "object",
  "required": [
    "schemaVersion",
    "changeSummary",
    "repository",
    "affectedComponents",
    "plannedPaths",
    "concerns",
    "riskLevel",
    "steps",
    "verificationCommands",
    "evidenceIds",
    "uncertainties",
    "contractFingerprint",
    "buildSystem"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "changeSummary": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string"
    },
    "affectedComponents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "plannedPaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "concerns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "riskLevel": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "UNKNOWN"
      ]
    },
    "steps": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:vericore:schema:engineering-plan-step-v1.0",
        "title": "Engineering plan step",
        "type": "object",
        "required": [
          "id",
          "description",
          "rationale",
          "evidenceIds",
          "verification"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verification": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "verificationCommands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contractFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "buildSystem": {
      "enum": [
        "MAVEN",
        "GRADLE",
        "UNKNOWN"
      ]
    },
    "specification": {
      "type": "object",
      "description": "Optional explicit change constraints. Their presence is not proof that each criterion has been evaluated.",
      "properties": {
        "requiredBehaviors": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "forbiddenBehaviors": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "protectedInvariants": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "acceptanceCriteria": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "requiredEvidence": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "evidenceBindings": {
          "type": "array",
          "description": "Optional references from stable criterion IDs to prepared evidence citation IDs or declared verification-command-NNN IDs. A binding does not prove the criterion.",
          "maxItems": 200,
          "items": {
            "type": "object",
            "required": [
              "criterionId",
              "evidenceIds"
            ],
            "properties": {
              "criterionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "evidenceIds": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "rule": {
                "type": "string",
                "enum": [
                  "MANUAL_REVIEW",
                  "ALL_BOUND_COMMANDS_SUCCEEDED"
                ],
                "default": "MANUAL_REVIEW",
                "description": "MANUAL_REVIEW is the safe default. ALL_BOUND_COMMANDS_SUCCEEDED is supported only for required-evidence criteria bound to declared verification-command-NNN IDs; it proves command exit status only."
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
