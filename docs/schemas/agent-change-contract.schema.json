{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vericore:schema:agent-change-contract-v2.0",
  "title": "Vericore Agent Change Contract",
  "type": "object",
  "required": [
    "schemaVersion",
    "changeSummary",
    "repository",
    "preparedHead",
    "plannedPaths",
    "expectedChangeTypes",
    "expectedComponents",
    "verificationCommands",
    "evidenceIds",
    "architectureExpectations",
    "fingerprint"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "changeSummary": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "preparedHead": {
      "type": "string"
    },
    "plannedPaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expectedChangeTypes": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "expectedComponents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verificationCommands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "architectureExpectations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
