{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vericore:schema:agent-change-contract-v2.0",
  "title": "Vericore Agent Change Contract",
  "type": "object",
  "required": [
    "schemaVersion",
    "changeSummary",
    "repository",
    "preparedHead",
    "plannedPaths",
    "expectedChangeTypes",
    "expectedComponents",
    "verificationCommands",
    "evidenceIds",
    "architectureExpectations",
    "fingerprint"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "changeSummary": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "preparedHead": {
      "type": "string"
    },
    "plannedPaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expectedChangeTypes": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "expectedComponents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verificationCommands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "architectureExpectations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "specification": {
      "type": "object",
      "description": "Optional explicit change constraints. Their presence is not proof that each criterion has been evaluated.",
      "properties": {
        "requiredBehaviors": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "forbiddenBehaviors": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "protectedInvariants": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "acceptanceCriteria": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "requiredEvidence": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "evidenceBindings": {
          "type": "array",
          "description": "Optional references from stable criterion IDs to evidence citation IDs already included in the prepared contract. A binding does not prove the criterion.",
          "maxItems": 200,
          "items": {
            "type": "object",
            "required": [
              "criterionId",
              "evidenceIds"
            ],
            "properties": {
              "criterionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "evidenceIds": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
