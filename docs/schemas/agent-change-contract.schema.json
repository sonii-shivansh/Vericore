{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vericore:schema:agent-change-contract-v3.1",
  "title": "Vericore Agent Change Contract",
  "type": "object",
  "required": [
    "schemaVersion",
    "changeSummary",
    "repository",
    "preparedHead",
    "plannedPaths",
    "expectedChangeTypes",
    "expectedComponents",
    "verificationCommands",
    "evidenceIds",
    "architectureExpectations",
    "fingerprint"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        "2.0",
        "2.1",
        "3.0",
        "3.1"
      ]
    },
    "changeSummary": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "preparedHead": {
      "type": "string"
    },
    "plannedPaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expectedChangeTypes": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "expectedComponents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verificationCommands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "architectureExpectations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "specification": {
      "type": "object",
      "description": "Optional explicit change constraints. Their presence is not proof that each criterion has been evaluated.",
      "properties": {
        "requiredBehaviors": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "forbiddenBehaviors": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "protectedInvariants": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "acceptanceCriteria": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "requiredEvidence": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "evidenceBindings": {
          "type": "array",
          "description": "Optional references from stable criterion IDs to prepared evidence citation IDs or declared verification-command-NNN IDs. A binding does not prove the criterion.",
          "maxItems": 200,
          "items": {
            "type": "object",
            "required": [
              "criterionId",
              "evidenceIds"
            ],
            "properties": {
              "criterionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "evidenceIds": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "rule": {
                "type": "string",
                "enum": [
                  "MANUAL_REVIEW",
                  "ALL_BOUND_COMMANDS_SUCCEEDED",
                  "ALL_BOUND_JUNIT_CASES_PASSED"
                ],
                "default": "MANUAL_REVIEW",
                "description": "MANUAL_REVIEW is the safe default. ALL_BOUND_COMMANDS_SUCCEEDED is supported only for required-evidence criteria bound to declared verification-command-NNN IDs and proves command exit status only. ALL_BOUND_JUNIT_CASES_PASSED evaluates explicitly bound junit-test-case:<class>#<name> selectors from fresh Gradle/Maven reports; it proves those named tests passed, not requirement coverage."
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "baselineManifest": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "schemaVersion",
        "entries",
        "digest",
        "fileCount",
        "totalBytes",
        "excludedPaths"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "kind",
              "size",
              "contentDigest",
              "executable"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "description": "Normalized repository-relative file path."
              },
              "kind": {
                "enum": [
                  "F",
                  "L"
                ]
              },
              "size": {
                "type": "integer",
                "minimum": 0
              },
              "contentDigest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "executable": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "fileCount": {
          "type": "integer",
          "minimum": 0
        },
        "totalBytes": {
          "type": "integer",
          "minimum": 0
        },
        "excludedPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "description": "Prepare-time deterministic per-path repository-input manifest. Required and digest-bound for schema 3.0; absent on legacy schema 2.0 contracts."
    },
    "agentContext": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "schemaVersion",
        "provider",
        "source"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0"
        },
        "provider": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "agentId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256,
          "minLength": 1
        },
        "sessionId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256,
          "minLength": 1
        },
        "eventId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256,
          "minLength": 1
        },
        "source": {
          "enum": [
            "cli",
            "mcp",
            "github-action",
            "rest",
            "other"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": "3.0"
          }
        },
        "required": [
          "schemaVersion"
        ]
      },
      "then": {
        "required": [
          "baselineManifest"
        ],
        "properties": {
          "baselineManifest": {
            "type": "object",
            "required": [
              "schemaVersion",
              "entries",
              "digest",
              "fileCount",
              "totalBytes",
              "excludedPaths"
            ],
            "properties": {
              "schemaVersion": {
                "const": "1.0"
              },
              "entries": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "path",
                    "kind",
                    "size",
                    "contentDigest",
                    "executable"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Normalized repository-relative file path."
                    },
                    "kind": {
                      "enum": [
                        "F",
                        "L"
                      ]
                    },
                    "size": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "contentDigest": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "executable": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "fileCount": {
                "type": "integer",
                "minimum": 0
              },
              "totalBytes": {
                "type": "integer",
                "minimum": 0
              },
              "excludedPaths": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
