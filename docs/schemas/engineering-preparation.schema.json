{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vericore:schema:engineering-preparation-v1.2",
  "title": "Vericore Engineering Preparation Result",
  "type": "object",
  "required": [
    "schemaVersion",
    "repository",
    "changeSet",
    "evidence",
    "plan",
    "contract",
    "provenance",
    "evidenceGraphDigest",
    "evidenceGraphNodeCount",
    "evidenceGraphEdgeCount"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.2"
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "changeSet": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:vericore:schema:preparation-change-set-v1.0",
      "title": "Preparation change set",
      "type": "object",
      "required": [
        "files",
        "source"
      ],
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "urn:vericore:schema:changed-file-v1.0",
            "title": "Changed file",
            "type": "object",
            "required": [
              "path",
              "changeType",
              "oldPath",
              "additions",
              "deletions"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "changeType": {
                "enum": [
                  "ADDED",
                  "MODIFIED",
                  "DELETED",
                  "RENAMED",
                  "COPIED"
                ]
              },
              "oldPath": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "additions": {
                "type": "integer",
                "minimum": 0
              },
              "deletions": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:vericore:schema:preparation-grounded-evidence-v1.1",
      "title": "Preparation grounded evidence",
      "type": "object",
      "required": [
        "schemaVersion",
        "citations",
        "repositoryCommit",
        "repositoryStateDigest",
        "analysisSchemaVersion"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.1"
        },
        "citations": {
          "type": "array"
        },
        "repositoryCommit": {
          "type": [
            "string",
            "null"
          ]
        },
        "repositoryStateDigest": {
          "type": [
            "string",
            "null"
          ]
        },
        "analysisSchemaVersion": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "plan": {
      "type": "object",
      "required": [
        "schemaVersion",
        "changeSummary",
        "repository",
        "affectedComponents",
        "plannedPaths",
        "concerns",
        "riskLevel",
        "steps",
        "verificationCommands",
        "evidenceIds",
        "uncertainties",
        "contractFingerprint",
        "buildSystem"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0"
        },
        "changeSummary": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "affectedComponents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "plannedPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "concerns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "riskLevel": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "UNKNOWN"
          ]
        },
        "steps": {
          "type": "array"
        },
        "verificationCommands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contractFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "buildSystem": {
          "enum": [
            "MAVEN",
            "GRADLE",
            "UNKNOWN"
          ]
        },
        "specification": {
          "type": "object",
          "description": "Optional explicit change constraints. Their presence is not proof that each criterion has been evaluated.",
          "properties": {
            "requiredBehaviors": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "forbiddenBehaviors": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "protectedInvariants": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "acceptanceCriteria": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "requiredEvidence": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "evidenceBindings": {
              "type": "array",
              "description": "Optional references from stable criterion IDs to prepared evidence citation IDs or declared verification-command-NNN IDs. A binding does not prove the criterion.",
              "maxItems": 200,
              "items": {
                "type": "object",
                "required": [
                  "criterionId",
                  "evidenceIds"
                ],
                "properties": {
                  "criterionId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "evidenceIds": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 20,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    }
                  },
                  "rule": {
                    "type": "string",
                    "enum": [
                      "MANUAL_REVIEW",
                      "ALL_BOUND_COMMANDS_SUCCEEDED",
                      "ALL_BOUND_JUNIT_CASES_PASSED"
                    ],
                    "default": "MANUAL_REVIEW",
                    "description": "MANUAL_REVIEW is the safe default. ALL_BOUND_COMMANDS_SUCCEEDED is supported only for required-evidence criteria bound to declared verification-command-NNN IDs and proves command exit status only. ALL_BOUND_JUNIT_CASES_PASSED evaluates explicitly bound junit-test-case:<class>#<name> selectors from fresh Gradle/Maven reports; it proves those named tests passed, not requirement coverage."
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "contract": {
      "type": "object",
      "required": [
        "schemaVersion",
        "changeSummary",
        "repository",
        "preparedHead",
        "plannedPaths",
        "expectedChangeTypes",
        "expectedComponents",
        "verificationCommands",
        "evidenceIds",
        "architectureExpectations",
        "fingerprint"
      ],
      "properties": {
        "schemaVersion": {
          "enum": [
            "2.0",
            "2.1",
            "3.0",
            "3.1"
          ]
        },
        "changeSummary": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "preparedHead": {
          "type": "string"
        },
        "plannedPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expectedChangeTypes": {
          "type": "object"
        },
        "expectedComponents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verificationCommands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "architectureExpectations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "specification": {
          "type": "object",
          "description": "Optional explicit change constraints. Their presence is not proof that each criterion has been evaluated.",
          "properties": {
            "requiredBehaviors": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "forbiddenBehaviors": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "protectedInvariants": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "acceptanceCriteria": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "requiredEvidence": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "evidenceBindings": {
              "type": "array",
              "description": "Optional references from stable criterion IDs to evidence citation IDs already included in the prepared contract. A binding does not prove the criterion.",
              "maxItems": 200,
              "items": {
                "type": "object",
                "required": [
                  "criterionId",
                  "evidenceIds"
                ],
                "properties": {
                  "criterionId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "evidenceIds": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 20,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    }
                  },
                  "rule": {
                    "type": "string",
                    "enum": [
                      "MANUAL_REVIEW",
                      "ALL_BOUND_COMMANDS_SUCCEEDED",
                      "ALL_BOUND_JUNIT_CASES_PASSED"
                    ],
                    "default": "MANUAL_REVIEW",
                    "description": "MANUAL_REVIEW is the safe default. ALL_BOUND_COMMANDS_SUCCEEDED is supported only for required-evidence criteria bound to declared verification-command-NNN IDs and proves command exit status only. ALL_BOUND_JUNIT_CASES_PASSED evaluates explicitly bound junit-test-case:<class>#<name> selectors from fresh Gradle/Maven reports; it proves those named tests passed, not requirement coverage."
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "baselineManifest": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "schemaVersion",
            "entries",
            "digest",
            "fileCount",
            "totalBytes",
            "excludedPaths"
          ],
          "properties": {
            "schemaVersion": {
              "const": "1.0"
            },
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "path",
                  "kind",
                  "size",
                  "contentDigest",
                  "executable"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Normalized repository-relative file path."
                  },
                  "kind": {
                    "enum": [
                      "F",
                      "L"
                    ]
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "contentDigest": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "executable": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              }
            },
            "digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "fileCount": {
              "type": "integer",
              "minimum": 0
            },
            "totalBytes": {
              "type": "integer",
              "minimum": 0
            },
            "excludedPaths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false,
          "description": "Prepare-time deterministic per-path repository-input manifest. Required and digest-bound for schema 3.0; absent on legacy schema 2.0 contracts."
        },
        "agentContext": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "schemaVersion",
            "provider",
            "source"
          ],
          "properties": {
            "schemaVersion": {
              "const": "1.0"
            },
            "provider": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
            },
            "agentId": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 256
            },
            "sessionId": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 256
            },
            "eventId": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 256
            },
            "source": {
              "enum": [
                "cli",
                "mcp",
                "github-action",
                "rest",
                "other"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "schemaVersion": {
                "const": "3.0"
              }
            },
            "required": [
              "schemaVersion"
            ]
          },
          "then": {
            "required": [
              "baselineManifest"
            ],
            "properties": {
              "baselineManifest": {
                "type": "object",
                "required": [
                  "schemaVersion",
                  "entries",
                  "digest",
                  "fileCount",
                  "totalBytes",
                  "excludedPaths"
                ],
                "properties": {
                  "schemaVersion": {
                    "const": "1.0"
                  },
                  "entries": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "path",
                        "kind",
                        "size",
                        "contentDigest",
                        "executable"
                      ],
                      "properties": {
                        "path": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Normalized repository-relative file path."
                        },
                        "kind": {
                          "enum": [
                            "F",
                            "L"
                          ]
                        },
                        "size": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "contentDigest": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        },
                        "executable": {
                          "type": "boolean"
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "fileCount": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "totalBytes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "excludedPaths": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "required": [
        "schemaVersion",
        "id",
        "operation",
        "repositoryCommit",
        "analysisSchemaVersion",
        "evidenceIds",
        "unknownReason"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "operation": {
          "type": "string"
        },
        "repositoryCommit": {
          "type": [
            "string",
            "null"
          ]
        },
        "analysisSchemaVersion": {
          "type": "string"
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unknownReason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "evidenceGraphDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidenceGraphNodeCount": {
      "type": "integer",
      "minimum": 0
    },
    "evidenceGraphEdgeCount": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
